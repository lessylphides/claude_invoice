{
  "name": "maeip-calendar",
  "version": "1.0.0",
  "description": "캘린더 형식 매입 물품 정리 앱 (영수증·거래명세서 촬영 자동 입력)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:all": "vitest run --passWithNoTests && playwright test",
    "deploy": "npm run build && node scripts/build-worker.mjs && wrangler deploy"
  },
