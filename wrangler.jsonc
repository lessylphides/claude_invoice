// Cloudflare Workers 배포 설정: 앱 화면 파일 + 서버 기능(/api/ocr)
// 배포: npm run deploy  (Cloudflare API 토큰 필요. 토큰·비밀 값은 저장소에 넣지 않음)
// 비밀 값 ANTHROPIC_API_KEY 는 Cloudflare 대시보드(costnote → 설정 → 변수 및 비밀)에서 넣음
{
  "name": "costnote",
  "account_id": "9ecdd9e050cc043f4c41cbef5f0b9853",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-07",
  // 클로드 연결: 클라이언트 정보 문서(CIMD)를 받아올 때 공개 인터넷 주소만 허용
  "compatibility_flags": ["global_fetch_strictly_public"],
  // 맞춤 도메인 3개는 Cloudflare 대시보드에서 연결해 둔 것 (배포할 때 풀리지 않게 여기에도 적어 둠)
  "routes": [
    { "pattern": "app.costnote.co.kr", "custom_domain": true },
    { "pattern": "costnote.co.kr", "custom_domain": true },
    { "pattern": "www.costnote.co.kr", "custom_domain": true }
  ],
  "preview_urls": false,
  "workers_dev": true,
  "observability": { "enabled": true },
  // 구독 정보(빌링키·결제 내역)를 두는 저장소: Durable Object (저장 직후에도 바로 최신 값)
  "durable_objects": { "bindings": [{ "name": "BILLING_DO", "class_name": "BillingStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BillingStore"] }],
  // 예전 저장소(KV): 처음 시험 결제 1건이 여기 있음. 새 저장소로 옮겨지면 지워도 됨
  // OAUTH_KV: 클로드 연결(커넥터) 로그인 토큰 저장 (토큰은 해시로만 저장, 내용은 암호화)
  "kv_namespaces": [
    { "binding": "BILLING", "id": "5592f6bf8d43431f8cef8e0a3ef07a0b" },
    { "binding": "OAUTH_KV", "id": "da18ac9c0ce2421db408a3629e0e2e29" }
  ],
  // 매일 한국 시간 오전 10시 7분에 정기결제
  "triggers": { "crons": ["7 1 * * *"] },
  // 비밀 값(대시보드에서 넣음): ANTHROPIC_API_KEY, TOSS_SECRET_KEY
  "vars": {
    "OCR_MODEL": "claude-opus-5-5",
    // 결제 시작 전(BILLING_MODE off/test)과 운영자 계정의 한도
    "OCR_DAILY_LIMIT": "30",
    "OCR_MONTHLY_LIMIT": "300",
    // off: 결제 숨김 | test: 시험 결제(구독자만 요금제 한도) | live: 실제 결제(무료 체험 20장·요금제 한도)
    "BILLING_MODE": "live",
    "OWNER_EMAILS": "hanguk.soek@me.com"
  }
}
